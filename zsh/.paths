# ------------------------------------------
# Paths
# ------------------------------------------

# Ensure unique paths
typeset -U path

# Prepend paths (Order matters: top is first in PATH)
path=(
  "$HOME/.local/bin"
  "/opt/homebrew/sbin"
  "/opt/homebrew/bin"
  "$HOME/.cargo/bin"
  "/opt/homebrew/opt/rustup/bin"
  $path
)

export PATH
