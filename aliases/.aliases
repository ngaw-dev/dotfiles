# Modern replacements for standard Unix commands
alias la='eza -lha'      # List all files in long form with hidden files
alias cat='bat'          # Syntax-highlighted cat replacement
alias ls='eza'           # Modern ls replacement with colors
alias l='eza -lh'        # List files in long form (no hidden)

# Custom commands
alias px='pnpm'

## ddev commands
alias pa='php artisan'
alias pa-clear='php artisan config:clear && php artisan route:clear && php artisan cache:clear'

alias www="cd /var/www"
