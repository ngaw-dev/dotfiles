alias ll='eza -lh'
alias la='eza -lha'
alias cat='bat'
alias ls='eza'
alias lla='eza -lha'

# Custom commands
alias px='pnpm'

alias myip='echo "IPv4:" && curl -4 ifconfig.me && echo "" && echo "IPv6:" && curl -6 ifconfig.me && echo ""'

# Silverstripe 
alias dbuild='ddev exec vendor/bin/sake dev/build flush=1'
alias dprocess='ddev exec vendor/bin/sake dev/tasks/ProcessJobQueueTask'

alias dbuild6='ddev exec vendor/bin/sake db:build --flush'
alias dprocess6='ddev exec vendor/bin/sake tasks:ProcessJobQueueTask'

alias dexec='ddev exec'
alias dpopulate='ddev exec vendor/bin/sake dev/tasks/PopulateTask'

alias dtask='ddev exec vendor/bin/sake dev/tasks'
alias dtask6='ddev exec vendor/bin/sake tasks'

alias ddjob="ddev exec \"mysql -u root -p'root' -e 'TRUNCATE QueuedJobDescriptor;' db\""

alias dpu='ddev exec vendor/bin/phpunit'

# SS Search
alias dconfigure="ddev exec sake dev/tasks/SearchConfigure"
alias dindex="ddev exec sake dev/tasks/SearchReindex"

alias dsearch="ddelete && dbuild && dconfigure && dindex && dprocess"

# Applications
alias brave="open -a 'Brave Browser.app'"
alias chrome="open -a /Applications/Google\ Chrome.app"

# FZF commands
alias fzfcode='fzf | xargs code'    
