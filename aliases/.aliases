alias dpu='ddev exec vendor/bin/phpunit'

alias dc="docker compose"

opencode() {
    if [[ -n "$HERDR_TAB_ID" ]]; then
        local current_label
        current_label=$(herdr tab get "$HERDR_TAB_ID" 2>/dev/null | jq -r '.result.tab.label // empty' 2>/dev/null)
        if [[ -n "$current_label" && "$current_label" != *"opencode"* ]]; then
            herdr tab rename "$HERDR_TAB_ID" "${current_label} opencode" 2>/dev/null
        fi
    fi
    command opencode "$@"
}
alias oc="opencode"
