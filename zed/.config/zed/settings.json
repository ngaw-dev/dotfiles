// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "tabs": {
    "git_status": false
  },
  "proxy": "",
  "markdown_preview": {
    "code_font_family": "MonoLisaCode Trial"
  },
  "ui_font_size": 15.0,
  "ui_font_weight": 400.0,
  "ui_font_family": "MonoLisaCode Trial",
  "cli_default_open_behavior": "existing_window",
  "suggest_extensions": false,
  "read_only_files": [
    "**/.cargo/registry/src/**/*.rs",
    "**/.cargo/git/checkouts/**/*.rs",
    "**/lib/rustlib/src/rust/library/**/*.rs",
    "...",
  ],
  "theme": "Catppuccin Mocha",
  "buffer_line_height": {
    "custom": 2.200000047683716,
  },
  "icon_theme": "Catppuccin Frappé",
  "base_keymap": "VSCode",
  "minimap": {
    "show": "never",
  },
  "cursor_blink": true,
  "buffer_font_family": "MonoLisaCode Trial",
  "buffer_font_features": {
    "calt": true,
    "liga": true,
  },
  "file_types": {
    "html": [".tpl", ".blade.php"],
    "css": [".scss", ".less"],
    "json": [".json", "composer.lock"],
  },
  "auto_indent_on_paste": true,
  "format_on_save": "off",
  "show_whitespaces": "all",
  "show_edit_predictions": true,
  "ensure_final_newline_on_save": true,
  "soft_wrap": "editor_width",
  "buffer_font_size": 13.0,
  "inlay_hints": {
    "enabled": false,
    "show_type_hints": true,
    "show_parameter_hints": true,
  },
  "vim": {
    "use_system_clipboard": "always",
  },
  "terminal": {
    "font_family": "MonoLisaCode Trial",
    "font_size": 13,
  },
  "scroll_beyond_last_line": "one_page",
  "relative_line_numbers": "disabled",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "vertical_scroll_margin": 5,
  "horizontal_scroll_margin": 5,
  "scrollbar": {
    "show": "auto",
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "right",
    "default_width": 360,
    "auto_reveal_entries": true,
    "git_status": true,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    },
    "intelephense": {
      "initialization_options": {
        "licenceKey": "~/intelephense/licence.txt",
      },
    },
  },
  "languages": {
    "TypeScript": {
      "auto_indent_on_paste": true,
      "show_whitespaces": "all",
      "show_edit_predictions": true,
      "ensure_final_newline_on_save": true,
      "wrap_guides": [120],
      "soft_wrap": "editor_width",
      "prettier": {
        "allowed": true,
        "arrow_parens": "always",
        "print_width": 100,
        "semi": true,
        "single_quote": true,
      },
    },
    "JavaScript": {
      "auto_indent_on_paste": true,
      "show_whitespaces": "all",
      "show_edit_predictions": true,
      "ensure_final_newline_on_save": true,
      "wrap_guides": [120],
      "soft_wrap": "editor_width",
      "prettier": {
        "allowed": true,
        "arrow_parens": "always",
        "print_width": 100,
        "semi": true,
        "single_quote": true,
      },
    },
    "TSX": {
      "auto_indent_on_paste": true,
      "show_whitespaces": "all",
      "show_edit_predictions": true,
      "ensure_final_newline_on_save": true,
      "wrap_guides": [120],
      "soft_wrap": "editor_width",
      "prettier": {
        "allowed": true,
        "arrow_parens": "always",
        "print_width": 100,
        "semi": true,
        "single_quote": true,
      },
    },
    "JSX": {
      "auto_indent_on_paste": true,
      "show_whitespaces": "all",
      "show_edit_predictions": true,
      "ensure_final_newline_on_save": true,
      "wrap_guides": [120],
      "soft_wrap": "editor_width",
      "prettier": {
        "allowed": true,
        "arrow_parens": "always",
        "print_width": 100,
        "semi": true,
        "single_quote": true,
      },
    },
    "JSON": {
      "auto_indent_on_paste": true,
      "show_whitespaces": "all",
      "show_edit_predictions": true,
      "ensure_final_newline_on_save": true,
      "wrap_guides": [120],
      "soft_wrap": "editor_width",
      "prettier": {
        "allowed": true,
        "print_width": 100,
      },
    },
    "CSS": {
      "auto_indent_on_paste": true,
      "show_whitespaces": "all",
      "show_edit_predictions": true,
      "ensure_final_newline_on_save": true,
      "wrap_guides": [120],
      "soft_wrap": "editor_width",
      "prettier": {
        "allowed": true,
        "single_quote": true,
      },
    },
    "SCSS": {
      "auto_indent_on_paste": true,
      "show_whitespaces": "all",
      "show_edit_predictions": true,
      "ensure_final_newline_on_save": true,
      "wrap_guides": [120],
      "soft_wrap": "editor_width",
      "prettier": {
        "allowed": true,
        "single_quote": true,
      },
    },
    "HTML": {
      "auto_indent_on_paste": true,
      "show_whitespaces": "all",
      "show_edit_predictions": true,
      "ensure_final_newline_on_save": true,
      "soft_wrap": "editor_width",
      "prettier": {
        "allowed": true,
        "print_width": 0,
      },
    },
    "PHP": {
      "auto_indent_on_paste": true,
      "show_whitespaces": "all",
      "show_edit_predictions": true,
      "ensure_final_newline_on_save": true,
      "wrap_guides": [120],
      "soft_wrap": "editor_width",
      "tab_size": 4,
      "formatter": "language_server",
      "language_servers": ["intelephense", "!phpactor"],
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
