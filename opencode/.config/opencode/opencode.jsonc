{
  "$schema": "https://opencode.ai/config.json",
  "skills": ["{env:HOME}/personal/mimir-wisdom"],
  "providers": {
    "zai-coding-plan": {
      "models": {
        "glm-4.7": {}
      }
    },
    "omniroute": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "settings": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:OMNI_ROUTE_API_KEY}"
      },
      "models": {
        "auto/best-free": {
          "name": "OmniRoute Auto (Best Free)"
        },
        "glm-combo": {
          "name": "Combo - OmniRoute GLM Paid"
        },
        "claude-combo": {
          "name": "Combo - OmniRoute Claude"
        },
        "google-combo": {
          "name": "Combo - OmniRoute Google"
        },
        "ch-models": {
          "name": "Combo - OmniRoute Chinese models"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest"
        ],
        "disabled": false
      }
    }
  }
}
