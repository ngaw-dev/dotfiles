{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "{env:HOME}/personal/mimir-wisdom"
    ]
  },
  "provider": {
    "zai-coding-plan": {
      "models": {
        "glm-4.7": {}
      }
    },
    "omni-route": {
        "options": {
            "baseURL": "http://localhost:20128/v1",
            "apiKey": "{env:OMNI_ROUTE_API_KEY}"
        },
        "models": {
            "auto/best-free": {
              "name": "OmniRoute Auto (Best Free)"
            },
            "zai/glm-5-turbo": {
              "name": "OmniRoute ZAI GLM-5 Turbo"
            },
            "zai/glm-5.2": {
              "name": "OmniRoute ZAI GLM-5.2"
            },
            "zai/glm-5.1": {
              "name": "OmniRoute ZAI GLM-5.1"
            },
            "oc/deepseek-v4-flash-free": {
              "name": "OmniRoute DeepSeek V4 Flash Free"
            },
            "oc/big-pickle": {
              "name": "OmniRoute Big Pickle"
            },
            "kr/claude-haiku-4.5": {
              "name": "OmniRoute Claude Haiku 4.5"
            },
            "kr/claude-sonnet-4.5": {
              "name": "OmniRoute Claude Sonnet 4.5"
            },
            "kr/deepseek-3.2": {
              "name": "OmniRoute DeepSeek 3.2"
            },
            "kr/minimax-m2.5": {
              "name": "OmniRoute MiniMax M2.5"
            },
            "kr/glm-5": {
              "name": "OmniRoute GLM-5"
            },
            "antigravity/gemini-3.6-flash-high": {
              "name": "OmniRoute Gemini 3.6 Flash High"
            },
            "antigravity/gemini-3.6-flash-medium": {
              "name": "OmniRoute Gemini 3.6 Flash Medium"
            },
            "antigravity/claude-sonnet-4-6": {
              "name": "OmniRoute Claude Sonnet 4.6"
            }
        }
    }
  },
  "lsp": {
    "oxlint": {
      "command": [
        "oxlint",
        "--lsp"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts",
        ".vue",
        ".astro",
        ".svelte"
      ]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  }
}
