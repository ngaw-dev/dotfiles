{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "{env:HOME}/personal/mimir-wisdom"
    ]
  },
  "provider": {
    "zai-coding-plan": {
      "models": {
        "glm-4.7": {}
      }
    },
    "omni-route": {
        "options": {
            "baseURL": "http://localhost:20128/v1",
            "apiKey": "{env:OMNI_ROUTE_API_KEY}"
        },
        "models": {
            "auto/best-free": {
              "name": "OmniRoute Auto (Best Free)"
            },
            "glm-combo": {
              "name": "Combo - OmniRoute GLM Paid"
            },
            "claude-combo": {
              "name": "Combo - OmniRoute Claude"
            },
            "google-combo": {
              "name": "Combo - OmniRoute Google"
            },
            "ch-models": {
                "name": "Combo - OmniRoute DeepSeek"
            }
        }
    }
  },
  "lsp": {
    "oxlint": {
      "command": [
        "oxlint",
        "--lsp"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts",
        ".vue",
        ".astro",
        ".svelte"
      ]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  }
}
